{% comment %}
  Phased campaign landing section. Illustrative, independently written example.

  Each "Phase" block holds its own dates, headline, offer, and button, so
  non-developers schedule a campaign entirely in the theme editor. The first
  block whose date window contains today wins; leave both dates empty on a
  final block to make it the evergreen fallback. Dates are text settings
  because theme settings have no date picker: YYYY-MM-DD for a one-off
  campaign, or MM-DD for a season that repeats every year. Use the same
  format for both dates in a block. Both formats compare correctly as text.

  "Today" comes from the shop's time zone at render time. Shopify caches
  storefront pages, so a phase can switch a little after midnight rather than
  exactly on it. Use a discount's own start and end dates for price changes;
  this section only changes the message.
{% endcomment %}

{%- liquid
  assign today = 'now' | date: '%Y-%m-%d'
  if request.design_mode and section.settings.preview_date != blank
    assign today = section.settings.preview_date
  endif

  assign today_md = today | slice: 5, 5

  assign active = nil
  for block in section.blocks
    assign starts = block.settings.start_date | default: ''
    assign ends = block.settings.end_date | default: ''
    assign matched = false

    # MM-DD dates repeat every year, for seasonal campaigns. A range whose
    # start is later than its end wraps over New Year (for example 12-26 to 01-02).
    if starts.size == 5 or ends.size == 5
      assign from = starts | default: '01-01'
      assign to = ends | default: '12-31'
      if from <= to
        if from <= today_md and today_md <= to
          assign matched = true
        endif
      elsif today_md >= from or today_md <= to
        assign matched = true
      endif
    else
      assign from = starts | default: '0000-01-01'
      assign to = ends | default: '9999-12-31'
      if from <= today and today <= to
        assign matched = true
      endif
    endif

    if matched
      assign active = block
      break
    endif
  endfor
-%}

{%- if active -%}
  <section class="campaign-phase" data-phase="{{ active.settings.label | handleize }}" {{ active.shopify_attributes }}>
    {%- if active.settings.eyebrow != blank -%}
      <p class="campaign-phase__eyebrow">{{ active.settings.eyebrow | escape }}</p>
    {%- endif -%}
    <h2 class="campaign-phase__headline">{{ active.settings.headline | escape }}</h2>
    {%- if active.settings.offer != blank -%}
      <div class="campaign-phase__offer">{{ active.settings.offer }}</div>
    {%- endif -%}
    {%- if active.settings.button_label != blank and active.settings.button_link != blank -%}
      <a class="campaign-phase__button" href="{{ active.settings.button_link }}">{{ active.settings.button_label | escape }}</a>
    {%- endif -%}
    {%- if request.design_mode -%}
      <p class="campaign-phase__editor-note">Showing phase "{{ active.settings.label | escape }}" for {{ today }}.</p>
    {%- endif -%}
  </section>
{%- elsif request.design_mode -%}
  <p class="campaign-phase__editor-note">No phase covers {{ today }}. Add a phase with no dates as a fallback.</p>
{%- endif -%}

{% stylesheet %}
  .campaign-phase { padding: 3rem 1.5rem; text-align: center; }
  .campaign-phase__eyebrow { text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.8125rem; }
  .campaign-phase__headline { margin: 0.5rem 0 1rem; font-size: clamp(1.75rem, 5vw, 3rem); }
  .campaign-phase__button { display: inline-block; margin-top: 1.25rem; padding: 0.75rem 1.5rem; border: 2px solid currentColor; text-decoration: none; }
  .campaign-phase__button:focus-visible { outline: 3px solid currentColor; outline-offset: 3px; }
  .campaign-phase__editor-note { font-style: italic; opacity: 0.7; }
{% endstylesheet %}

{% schema %}
{
  "name": "Campaign phases",
  "settings": [
    {
      "type": "text",
      "id": "preview_date",
      "label": "Preview date (theme editor only)",
      "info": "YYYY-MM-DD. Lets you check a future phase before it goes live. Ignored on the live storefront."
    }
  ],
  "blocks": [
    {
      "type": "phase",
      "name": "Phase",
      "settings": [
        { "type": "text", "id": "label", "label": "Internal name", "default": "Phase" },
        { "type": "text", "id": "start_date", "label": "Start date", "info": "YYYY-MM-DD for one year, or MM-DD to repeat every year. Inclusive. Leave empty for no start limit." },
        { "type": "text", "id": "end_date", "label": "End date", "info": "YYYY-MM-DD or MM-DD, inclusive. An MM-DD end earlier than the start wraps over New Year." },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow text" },
        { "type": "text", "id": "headline", "label": "Headline", "default": "Campaign headline" },
        { "type": "richtext", "id": "offer", "label": "Offer details" },
        { "type": "text", "id": "button_label", "label": "Button label" },
        { "type": "url", "id": "button_link", "label": "Button link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Campaign phases",
      "blocks": [
        { "type": "phase", "settings": { "label": "Early access", "headline": "Early access is open" } },
        { "type": "phase", "settings": { "label": "Main event", "headline": "The sale is on" } },
        { "type": "phase", "settings": { "label": "Evergreen", "headline": "Explore the range" } }
      ]
    }
  ]
}
{% endschema %}
